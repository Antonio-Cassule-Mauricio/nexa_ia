# ==============================================================================
# CONFIGURAÇÃO DE VARIÁVEIS DE AMBIENTE — MAURÍCIUS TECH & NEXA ASSISTANT
# Copie este ficheiro para .env e preencha com as suas chaves reais
# NUNCA envie o ficheiro .env para repositórios públicos (GitHub/GitLab)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. MOTORES DE INTELIGÊNCIA ARTIFICIAL (LLMs)
# ------------------------------------------------------------------------------
# Chave da API Qwen (Alibaba Cloud / DashScope Maas - qwen3.8-max)
QWEN_API_KEY=
QWEN_BASE_URL=https://ap-southeast-1.maas.qwencloudapi.com/compatible-mode/v1
QWEN_MODEL=qwen3.8-max

# Chave da API Google Gemini (Contingência e processamento complementar)
GEMINI_API_KEY=

# ------------------------------------------------------------------------------
# 2. BASE DE DADOS & AUTENTICAÇÃO (SUPABASE POSTGRESQL)
# ------------------------------------------------------------------------------
SUPABASE_URL=https://qcerpfbyrifbfqnphxdl.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=https://qcerpfbyrifbfqnphxdl.supabase.co/auth/v1/.well-known/jwks.json

# Prefixo VITE para frontend React
VITE_SUPABASE_URL=https://qcerpfbyrifbfqnphxdl.supabase.co
VITE_SUPABASE_ANON_KEY=

# ------------------------------------------------------------------------------
# 3. CONECTOR WHATSAPP PESSOAL (BAILEYS / QR CODE & PAIRING CODE)
# ------------------------------------------------------------------------------
# Não requer chaves de API pagas! Conecta diretamente ao WhatsApp no telemóvel
# através de escaneamento de QR Code ou Código de Pareamento de 8 dígitos.
WA_API_MODE=personal_baileys

# ------------------------------------------------------------------------------
# 4. CONECTOR WHATSAPP EMPRESARIAL OFICIAL (META CLOUD API - OPCIONAL)
# ------------------------------------------------------------------------------
WA_META_PHONE_NUMBER_ID=
WA_META_ACCESS_TOKEN=
WA_META_BUSINESS_ACCOUNT_ID=
WA_META_APP_SECRET=
WA_WEBHOOK_VERIFY_TOKEN=
WA_PHONE_NUMBER=

# ------------------------------------------------------------------------------
# 5. INTEGRAÇÕES COMPLEMENTARES
# ------------------------------------------------------------------------------
SLACK_WEBHOOK_URL=

# ------------------------------------------------------------------------------
# 6. CONFIGURAÇÕES DE EXECUÇÃO E SERVIDOR
# ------------------------------------------------------------------------------
PORT=3000
HOST=0.0.0.0
NODE_ENV=development